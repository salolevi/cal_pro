// Copy this file to Config/Secrets.xcconfig (which is gitignored) and fill in.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// The publishable key is in the Supabase dashboard under
// Project Settings → API Keys → publishable key (starts with sb_publishable_).
//
// Do NOT put the secret key (sb_secret_ / service_role) here. It bypasses RLS
// entirely and must never ship inside a client app.

SUPABASE_PUBLISHABLE_KEY =

// Required only when building for a physical device. Your 10-character Apple
// Developer Team ID; leave empty for simulator builds.
DEVELOPMENT_TEAM =
